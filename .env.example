# ──────────────────────────────────────────────────────────────────────
# LLM Gateway — configuration reference
#
#     cp .env.example .env
#
# Every value below is the code default when unset, and every default works
# with an empty file: no credentials → the fallback chain terminates on the
# MockProvider (ADR-0006); storage falls back to local SQLite.
#
# Gateway knobs:      GW_<GROUP>__<FIELD>   (double underscore)
# Provider creds:     standard names (OPENAI_API_KEY, ANTHROPIC_API_KEY)
#
# docker compose interpolates $VARS from this same file — set provider keys
# here once and both local runs and containers pick them up.
# ──────────────────────────────────────────────────────────────────────

# ── App ─────────────────────────────────────────────────────────────
GW_APP__ENVIRONMENT=development          # development | test | production
GW_APP__HOST=0.0.0.0
GW_APP__PORT=8000
GW_APP__WORKERS=1                        # must stay 1 — in-memory FAISS + breaker state (DESIGN.md §13)
GW_APP__LOG_LEVEL=INFO

# ── Auth & rate limiting (Day 6) ─────────────────────────────────────
GW_AUTH__API_KEYS=gw-demo-key             # comma-separated; stored/compared as SHA-256 only
GW_AUTH__RATE_LIMIT_RPM=120               # per-key token bucket
GW_AUTH__RATE_LIMIT_BURST=30

# ── Redis ────────────────────────────────────────────────────────────
GW_REDIS__URL=redis://localhost:6379/0

# ── Cache (Day 3) ─────────────────────────────────────────────────────
GW_CACHE__ENABLED=true                    # master flag
GW_CACHE__SEMANTIC_ENABLED=true           # false → exact-match only
GW_CACHE__DEGRADED_MODE=false             # opt-in: exact hits only during total outage (ADR-0004)
GW_CACHE__SIMILARITY_THRESHOLD=0.95       # run benchmarks/threshold_sweep.py before changing
GW_CACHE__NEAR_MISS_FLOOR=0.85            # [floor, threshold) is logged as calibration data
GW_CACHE__EXACT_TTL_SECONDS=3600
GW_CACHE__SEMANTIC_TTL_SECONDS=86400
GW_CACHE__MAX_SEMANTIC_ENTRIES=50000      # memory bound — IndexFlatIP grows linearly (ADR-0005)
GW_CACHE__EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
GW_CACHE__EMBEDDER_THREADS=4
#GW_CACHE__PAYLOAD_STORE_URL=sqlite:///./cache_payloads.db

# ── Router (Day 4) ────────────────────────────────────────────────────
GW_ROUTER__ENABLED=true
GW_ROUTER__KEYWORDS_PATH=data/keywords.yaml   # rules are data, not code (ADR-0001)
GW_ROUTER__DEFAULT_TIER=standard              # cheap | standard | premium

# ── Reliability (Days 2 & 6) ──────────────────────────────────────────
GW_RELIABILITY__MAX_RETRIES=3
GW_RELIABILITY__BACKOFF_BASE_S=0.5
GW_RELIABILITY__BACKOFF_CAP_S=5.0
GW_RELIABILITY__REQUEST_TIMEOUT_BUDGET_S=30.0   # whole request, all providers
GW_RELIABILITY__PER_ATTEMPT_TIMEOUT_S=10.0      # one provider can't eat the budget
GW_RELIABILITY__BREAKER_WINDOW=20
GW_RELIABILITY__BREAKER_FAILURE_RATE=0.5        # ≥ 50% over window → open
GW_RELIABILITY__BREAKER_COOLDOWN_S=30.0         # open → half-open after this
GW_RELIABILITY__BREAKER_HALF_OPEN_PROBES=3

# ── Idempotency ───────────────────────────────────────────────────────
GW_IDEMPOTENCY__ENABLED=true             # X-Idempotency-Key → cached response
GW_IDEMPOTENCY__TTL_SECONDS=300

# ── Observability (Day 5) ──────────────────────────────────────────────
GW_OBSERVABILITY__DATABASE_URL=sqlite:///./gateway.db
GW_OBSERVABILITY__PRICING_PATH=data/pricing.yaml

# ── Mock provider (ADR-0006) ───────────────────────────────────────────
GW_MOCK__ENABLED=true                    # fallback-chain terminator; zero-credential mode
GW_MOCK__LATENCY_MS=800
GW_MOCK__ERROR_RATE=0.0                 # >0 simulates a flaky provider (chaos demos)

# ── Providers — leave empty for mock-only mode ────────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-haiku-latest